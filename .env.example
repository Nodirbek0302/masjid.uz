# Copy to /etc/masjid-uz.env (chmod 600). Never commit real values.
DATABASE_URL=postgresql://masjid_app:CHANGE_ME@127.0.0.1:5432/masjid
ADMIN_TG_IDS=           # moderator Telegram ID(s), comma separated (send /id to the bot). Empty = nobody can moderate
ADMIN_ALLOW_TOKEN=0     # development only: 1 enables the ADMIN_TOKEN login form
ADMIN_TOKEN=            # development only (with ADMIN_ALLOW_TOKEN=1)
TELEGRAM_BOT_TOKEN=     # optional; enables verified Telegram identity for the Mini App
HOST=127.0.0.1          # keep local; Caddy terminates TLS
PORT=8080
TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty   # swap for a self-hosted style if needed
DUPLICATE_RADIUS_M=50
REPORT_THRESHOLD=3      # distinct open reports before status becomes "reported"
WRITE_RATE_PER_MIN=30
SHOW_TILE_MOSQUES=1     # set 0 after running server/import_osm.py (tile layer finds mosques only by name)
TRUST_PROXY=0           # set 1 ONLY behind Caddy: then rate limits use the client address Caddy appends to X-Forwarded-For
PRAYER_FAJR_ANGLE=15     # daily prayer times strip; tune to match the official Uzbek calendar
PRAYER_ISHA_ANGLE=15
PRAYER_ASR_FACTOR=2     # 2 = Hanafi
PRAYER_DHUHR_OFFSET_MIN=5   # minutes after solar noon (calendars add a safety margin)

# ── Docker (docker-compose.yml) ──
COMPOSE_PROFILES=osm,https,bot   # osm = OSM masjidlarini kuniga 1 marta yangilash | https = Caddy (DOMAIN kerak) | cloudflare = Tunnel | bot = Telegram bot. Qaysi biri kerak bo'lsa shuni qoldiring
DOMAIN=                      # masjid.example.uz (HTTPS, A yozuvi server IP'siga) YOKI domensiz: http://SERVER_IP (faqat HTTP: geolokatsiya va Telegram Mini App ishlamaydi!)
POSTGRES_PASSWORD=           # openssl rand -hex 24  (faqat hex)
WEBAPP_URL=                  # https://<DOMAIN>/  (bot Mini App tugmasi uchun)
CLOUDFLARE_TUNNEL_TOKEN=     # faqat cloudflare profili uchun
OSM_CONTACT=             # Overpass'ga yuboriladigan aloqa manzili (email)
OSM_SYNC_HOURS=24

# IP xeshi uchun tuz (bo'sh bo'lsa ADMIN_TOKEN ishlatiladi)
ACTOR_SALT=
BOT_USERNAME=            # bot's @username without @; enables the 'By photo (Telegram)' link in the web panel

# Voice messages (speech-to-text on the server): tiny / base / small. Bigger = more accurate, slower, more RAM. Needs faster-whisper in the image.
WHISPER_MODEL=base

# Reading a timetable photo sent by the mobile app (POST /api/timetable/read; needs Tesseract, which the Docker image has)
PHOTO_PER_HOUR=30
OCR_CONCURRENCY=2
MAX_PHOTO_BYTES=8388608
