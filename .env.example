# Names only, with a comment each. Copy to .env for LOCAL development (TIMUS_ENV=dev); .env is git-ignored and is never read in staging/prod.
TIMUS_ENV=dev                                   # dev | staging | prod
TIMUS_APP_MASJIDUZ_DB_HOST=127.0.0.1            # PostgreSQL 17 host
TIMUS_APP_MASJIDUZ_DB_PORT=5432
TIMUS_APP_MASJIDUZ_DB_NAME=masjid
TIMUS_APP_MASJIDUZ_DB_USER=masjid
TIMUS_APP_MASJIDUZ_DB_PASSWORD=                 # SECRET. required in staging/prod
TIMUS_APP_MASJIDUZ_DB_POOL_MAX=10                # database connections of the whole serve container (split between its workers)
TIMUS_APP_MASJIDUZ_WEB_CONCURRENCY=4             # serve worker processes sharing port 8080 (1-16); about one per CPU of the container
TIMUS_APP_MASJIDUZ_ACTOR_SALT=                  # SECRET. salt for the hashed client network (required in staging/prod)
TIMUS_APP_MASJIDUZ_TELEGRAM_BOT_TOKEN=          # SECRET. Mini App identity + the bot (required in staging/prod)
TIMUS_APP_MASJIDUZ_MODERATOR_IDS=               # Telegram user ids allowed to moderate, comma separated (send /id to the bot)
TIMUS_APP_MASJIDUZ_ADMIN_TOKEN=                 # SECRET, optional, >= 32 chars: bearer-token moderation login; off when empty
TIMUS_APP_MASJIDUZ_CORS_ORIGINS=                # allowed web origins, comma separated; empty = none (never * in prod); EMPTY in TIMUS v1
TIMUS_APP_MASJIDUZ_API_BASE=/masjiduz/v1        # API base URL handed to the web client (config.js)
TIMUS_APP_MASJIDUZ_TRUSTED_PROXIES=             # CIDRs whose X-Forwarded-For is trusted; TIMUS: 127.0.0.1/32,::1/128,172.16.0.0/12 (default: loopback and private networks)
TIMUS_APP_MASJIDUZ_COMMIT=                      # git sha, set by the TIMUS CI
TIMUS_APP_MASJIDUZ_BOT_USERNAME=                # bot @username without @ (the web panel links to it)
TIMUS_APP_MASJIDUZ_WEBAPP_URL=                  # https URL of the web client for the bot's Mini App buttons; EMPTY in TIMUS v1 (the bot then has no Mini App buttons)
TIMUS_APP_MASJIDUZ_WRITE_RATE_PER_HOUR=30       # community writes per client address per hour
TIMUS_APP_MASJIDUZ_DUPLICATE_RADIUS_M=50
TIMUS_APP_MASJIDUZ_REPORT_THRESHOLD=3           # distinct open reports before a mosque becomes "reported"
TIMUS_APP_MASJIDUZ_SHOW_TILE_MOSQUES=1          # 0 once the OSM import has filled the database
TIMUS_APP_MASJIDUZ_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty   # map style (its host goes into the CSP)
TIMUS_APP_MASJIDUZ_OVERPASS_URL=https://overpass-api.de/api/interpreter          # import-osm only
TIMUS_APP_MASJIDUZ_GEMINI_API_KEY=          # SECRET, optional; several keys (separate projects), comma separated, add their limits. Reading is off without any key (needs Eldor's approval)
TIMUS_APP_MASJIDUZ_AI_DAILY_LIMIT=300                # photo/voice readings per day for all users together (Eldor requires a daily limit); cached answers are free
TIMUS_APP_MASJIDUZ_GEMINI_MODELS=gemini-3.5-flash-lite:15:500,gemini-3.1-flash-lite:15:500,gemini-3.6-flash:5:20   # name:requestsPerMinute:requestsPerDay, tried in this order (copy the limits from AI Studio)
TIMUS_APP_MASJIDUZ_PRAYER_FAJR_ANGLE=15         # home-page prayer times; tune to the official Uzbek calendar
TIMUS_APP_MASJIDUZ_PRAYER_ISHA_ANGLE=15
TIMUS_APP_MASJIDUZ_PRAYER_ASR_FACTOR=2          # 2 = Hanafi
TIMUS_APP_MASJIDUZ_PRAYER_DHUHR_OFFSET_MIN=5
